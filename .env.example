# Copy to .env and fill in. .env is git-ignored and is the only place secrets are kept.

# Claude API key. Read only by the local backend (npm run backend). It has no VITE_ prefix, so
# Vite never puts it in the app. In production it lives in the Apps Script's Script Properties.
CLAUDE_API_KEY=
# Optional. Defaults to claude-haiku-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# Password the app sends with every request (16+ characters). Vite puts VITE_ values inside the
# app, so this one is only as private as the app link. In production it must equal APP_SECRET in
# Script Properties.
VITE_APP_SECRET=

# Where the app sends requests. Local backend: http://localhost:8790
# Production: the Apps Script web app URL ending in /exec.
VITE_API_URL=http://localhost:8790

# --- The stock server (server/) ---------------------------------------------------------------
# Not needed while the app talks to the Apps Script directly. None of these has a VITE_ prefix,
# so none can reach the app.

# The database. This one is the local Postgres from "npm run db:up" in server/.
DATABASE_URL=postgres://stock:stock@127.0.0.1:54329/stock

# The Apps Script web app (URL ending in /exec). The server copies every saved change to the
# Sheet through it and keeps product photos in Google Drive. Leave empty to run without Google.
SHEET_GATEWAY_URL=
# SERVER_SECRET in the Apps Script's Script Properties: the key to the actions only the server may
# call. Needed with SHEET_GATEWAY_URL. It must not be the app's secret, which every phone holds.
# SHEET_GATEWAY_SECRET=

# A hosted Postgres gives two addresses: the pooled one above for the server, and a direct one for
# the commands that change the tables. Optional: empty means DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Optional. Defaults: port 8791, any origin, Africa/Accra.
# PORT=8791
# ALLOWED_ORIGINS=https://queenscode-stock.vercel.app
# SHOP_TIME_ZONE=Africa/Accra
